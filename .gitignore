# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
next-env.d.ts

# Env files — real secrets never committed, only .env.example templates
.env
.env.local
.env.*.local

# Local data stores
.qdrant-local/
*.pdf.local

# Android — build/ and out/ are regenerated by apps/android/build.sh from
# source; keystore/ holds real signing-key material and must never be
# committed (see docs/06-STROMEX-ANDROID-BUILD.md). apps/android/release/
# holds the built, signed deliverables and IS committed.
apps/web/out/
apps/android/build/
apps/android/keystore/

# apps/web/android — reference Capacitor/Gradle project (see
# docs/05-STROMEX-ANDROID-BUILD.md for why it's unverified in this repo's
# build environment). Standard Gradle/Android build cruft, not source.
apps/web/android/.gradle/
apps/web/android/build/
apps/web/android/app/build/
apps/web/android/capacitor-cordova-android-plugins/build/
apps/web/android/local.properties

# OS/editor
.DS_Store
*.swp
tsconfig.tsbuildinfo
dump.rdb

# EdTechX
apps/edtechx-api/.venv/
apps/edtechx-api/.pytest_cache/

# Concept plates carry every typeface as a data URI — 4–6 MB each — and are
# regenerated by `tools/design/concepts.py` in one command. The rendered PNGs
# are the reviewable artefact and are committed; the HTML is not.
docs/edtechx/design/concepts/*.html
