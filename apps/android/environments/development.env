# Development: a backend running on the same device the app is installed
# on. 10.0.2.2 is the Android emulator's alias for the host machine's
# localhost; on a real device with the backend running on your workstation,
# replace this with that workstation's LAN IP (e.g. http://192.168.1.20:8000).
# Exporting NEXT_PUBLIC_API_URL before running build-for-env.sh overrides
# this default without editing the file.
NEXT_PUBLIC_API_URL="${NEXT_PUBLIC_API_URL:-http://10.0.2.2:8000}"
VERSION_NAME_SUFFIX=-dev
