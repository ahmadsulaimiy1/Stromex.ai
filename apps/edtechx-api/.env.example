# EdTechX API — development configuration
# Copy to .env and adjust. Never commit .env.

EDTECHX_ENVIRONMENT=development
EDTECHX_DEBUG=false

# 32+ characters. Production refuses to boot without a real value.
EDTECHX_SECRET_KEY=CHANGE_ME_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS

# The request path. MUST be a role WITHOUT bypassrls that does NOT own the
# tables — otherwise FORCE ROW LEVEL SECURITY is bypassed and tenant isolation
# silently disappears while every test still passes.
EDTECHX_DATABASE_URL=postgresql+psycopg://edtechx_app:edtechx_app@localhost:5432/edtechx

# DDL only. Never used to serve a request.
EDTECHX_MIGRATION_DATABASE_URL=postgresql+psycopg://edtechx_migrator:edtechx_migrator@localhost:5432/edtechx

EDTECHX_REDIS_URL=redis://localhost:6379/0

# Hosts under this suffix resolve a tenant by their leftmost label:
#   st-bede.edtechx.localhost -> tenant slug "st-bede"
EDTECHX_TENANT_BASE_DOMAIN=edtechx.localhost

EDTECHX_CORS_ORIGINS=["http://localhost:3000"]
