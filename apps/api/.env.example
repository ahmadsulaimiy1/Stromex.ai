ENVIRONMENT=development
# ENVIRONMENT=production additionally requires: SECRET_KEY to be changed and
# >=32 chars, QDRANT_URL to be set, and CORS_ORIGINS to be changed from the
# localhost default — Settings.validate_for_production() refuses to boot
# otherwise (see app/core/config.py and docs/04-STROMEX-INDEPENDENT-AUDIT.md).
SECRET_KEY=replace-with-a-long-random-value-in-every-real-environment
DATABASE_URL=postgresql+psycopg://stromex:stromex@localhost:5432/stromex
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0

# Leave unset to use Qdrant's embedded local-file mode (dev/test only — not
# safe across multiple workers/replicas, and capped at ~20,000 points before
# Qdrant's own client warns against it). Set QDRANT_URL to point at a running
# Qdrant service in every real deployment (e.g. in docker-compose,
# http://qdrant:6333) — required in production, enforced at startup.
QDRANT_LOCAL_PATH=./.qdrant-local
QDRANT_URL=
QDRANT_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]
# The Android app (apps/android) ships a WebView that serves its own bundle
# from the virtual origin https://stromex.local instead of file:// (see
# apps/android/src/ai/stromex/app/MainActivity.java for why). Add that origin
# to whatever backend the app's API base URL actually points at, e.g.:
# CORS_ORIGINS=["http://localhost:3000","https://stromex.local"]

# All optional — the routing engine skips any provider whose key is unset,
# and falls over to the next one in the chain. In development, if none of
# these are set, chat falls back to a clearly-labeled dev-only echo provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

ADMIN_BOOTSTRAP_EMAIL=

# Used to build links that point outside the API itself: password-reset and
# email-verification links (sent by email), and where the Google OAuth
# callback redirects after a successful sign-in on the web app.
FRONTEND_BASE_URL=http://localhost:3000
# Must match the Android app's registered deep-link scheme
# (apps/android/AndroidManifest.xml's intent-filter) — the Google OAuth
# callback redirects here after a successful sign-in from the Android app.
APP_DEEP_LINK_SCHEME=ai.stromex.app

# Email delivery for password-reset/verification links. Leave every SMTP_*
# field unset to run in dev mode: the link is logged (see app/core/email.py)
# instead of emailed, so the full flow works with zero external accounts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=no-reply@stromex.ai

# Google Sign-In. Requires a real OAuth 2.0 Client (type "Web application")
# created at https://console.cloud.google.com/apis/credentials, with
# GOOGLE_REDIRECT_URI added to that client's Authorized redirect URIs
# (e.g. https://your-backend.example.com/api/v1/auth/google/callback).
# Leave unset to disable Google Sign-In — GET /auth/google/authorize
# returns 503 rather than redirecting into a nonexistent client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
