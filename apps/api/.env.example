ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-value-in-every-real-environment
DATABASE_URL=postgresql+psycopg://stromex:stromex@localhost:5432/stromex
REDIS_URL=redis://localhost:6379/0

# Leave unset to use Qdrant's embedded local-file mode; set QDRANT_URL to point
# at a running Qdrant service (e.g. in docker-compose, http://qdrant:6333).
QDRANT_LOCAL_PATH=./.qdrant-local
QDRANT_URL=
QDRANT_API_KEY=

CORS_ORIGINS=["http://localhost:3000"]

# All optional — the routing engine skips any provider whose key is unset,
# and falls over to the next one in the chain. In development, if none of
# these are set, chat falls back to a clearly-labeled dev-only echo provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=

ADMIN_BOOTSTRAP_EMAIL=
